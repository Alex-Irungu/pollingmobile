# Expo SDK 57 ships react@19.2.3, but pulls react-dom@19.3.0 as an optional
# peer, and react-dom@19.3 declares peer react@^19.3.0. That contradiction is
# inside the SDK's own dependency graph, not ours, and it makes npm refuse to
# install ANY additional package.
#
# react-dom is only reachable through Expo's web/devtools paths, which a
# native-only field app never loads, so the conflict has no runtime effect.
legacy-peer-deps=true
